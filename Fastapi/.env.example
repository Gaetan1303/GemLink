# FastAPI runtime. Railway must set APP_ENV=production explicitly.
APP_ENV=development
APP_HOST=0.0.0.0
PORT=3000

# Shared only with Symfony; minimum 32 random characters in production.
INTERNAL_API_KEY=

# Feature switches. Missing optional checkpoints keep the service degraded.
AI_ENABLED=true
VISION_ENABLED=true
LLM_ENABLED=true

# Ollama is private. Production must set these variables explicitly.
OLLAMA_URL=http://ollama:11434
OLLAMA_TEXT_MODEL=qwen3:0.6b
OLLAMA_VISION_MODEL=moondream

# Torchvision SSDLite checkpoint. Legacy YOLO checkpoints are incompatible.
DETECTOR_BACKEND=torchvision
DETECTOR_MODEL_PATH=checkpoints/detector_stones.pth
DETECTOR_MODEL_VERSION=stone-detector-v1
DETECTION_CONFIDENCE_THRESHOLD=0.5

# GemLink ViT checkpoint and activation registry.
VIT_MODEL_PATH=checkpoints/vit_stones.pth
VIT_MODEL_VERSION=vit-stones-v1
VIT_VERSIONS_ROOT=checkpoints/versions
FINE_TUNE_STATE_PATH=checkpoints/fine_tuning_state.json
FINE_TUNE_MAX_LOG_LINES=500
FINE_TUNE_EPOCHS=15

# Embeddings remain 512-dimensional to preserve the PostgreSQL contract.
CLIP_MODEL_ARCH=ViT-B-32
# Chemin local/monté vers un poids approuvé ; aucun téléchargement implicite.
CLIP_MODEL_PATH=/app/checkpoints/clip_vit_b_32_openai.pt
# Métadonnée de provenance/version, jamais utilisée comme URL de téléchargement.
CLIP_MODEL_PRETRAINED=openai
CLIP_MODEL_VERSION=clip-vit-b-32-openai

# Used only when fine-tuning downloads media through the private Symfony URL.
MEDIA_INTERNAL_BASE_URL=http://api:8080
