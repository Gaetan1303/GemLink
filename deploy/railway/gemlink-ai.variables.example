APP_ENV=production
PORT=3000
INTERNAL_API_KEY=${{shared.INTERNAL_API_KEY}}
AI_ENABLED=true
VISION_ENABLED=true
LLM_ENABLED=true

OLLAMA_URL=http://${{gemlink-ollama.RAILWAY_PRIVATE_DOMAIN}}:11434
OLLAMA_TEXT_MODEL=qwen3:0.6b
OLLAMA_VISION_MODEL=moondream

DETECTOR_BACKEND=torchvision
DETECTOR_MODEL_PATH=/app/checkpoints/detector_stones.pth
DETECTOR_MODEL_VERSION=stone-detector-v1
VIT_MODEL_PATH=/app/checkpoints/vit_stones.pth
VIT_MODEL_VERSION=vit-stones-v1
CLIP_MODEL_ARCH=ViT-B-32
CLIP_MODEL_PATH=/app/checkpoints/clip_vit_b_32_openai.pt
CLIP_MODEL_PRETRAINED=openai
CLIP_MODEL_VERSION=clip-vit-b-32-openai

MEDIA_INTERNAL_BASE_URL=http://${{gemlink-api.RAILWAY_PRIVATE_DOMAIN}}:8080
