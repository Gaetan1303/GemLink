APP_ENV=prod
APP_DEBUG=0
PORT=8080
APP_SECRET=${{shared.APP_SECRET}}
APP_URL=https://caverne.gem-link.org
DEFAULT_URI=https://caverne.gem-link.org
FRONTEND_URL=https://gem-link.org
TRUSTED_PROXIES=127.0.0.1
TRUSTED_HOSTS=^(caverne\.gem-link\.org|[a-z0-9-]+\.up\.railway\.app|[a-z0-9-]+\.railway\.internal)(:[0-9]+)?$
CORS_ALLOW_ORIGIN=^https://(www\.)?gem-link\.org$

DATABASE_URL=${{pgvector.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}
MESSENGER_TRANSPORT_DSN=${{Redis.REDIS_URL}}/messages
MESSENGER_LOW_PRIORITY_TRANSPORT_DSN=${{Redis.REDIS_URL}}/identification_low_priority
MESSENGER_FAILED_TRANSPORT_DSN=doctrine://default?queue_name=failed

JWT_SECRET_KEY=/tmp/gemlink-jwt/private.pem
JWT_PUBLIC_KEY=/tmp/gemlink-jwt/public.pem
JWT_PASSPHRASE=${{shared.JWT_PASSPHRASE}}
JWT_PRIVATE_KEY_B64=${{shared.JWT_PRIVATE_KEY_B64}}
JWT_PUBLIC_KEY_B64=${{shared.JWT_PUBLIC_KEY_B64}}

MAILER_DSN=${{shared.MAILER_DSN}}
MAILER_FROM_EMAIL=contact@gem-link.org
MAILER_FROM_NAME=GemLink

AI_ENABLED=true
AI_SERVICE_URL=http://${{gemlink-ai.RAILWAY_PRIVATE_DOMAIN}}:3000
INTERNAL_API_KEY=${{shared.INTERNAL_API_KEY}}

MEDIA_STORAGE_MODE=r2
R2_ACCOUNT_ID=${{shared.R2_ACCOUNT_ID}}
R2_ACCESS_KEY_ID=${{shared.R2_ACCESS_KEY_ID}}
R2_SECRET_ACCESS_KEY=${{shared.R2_SECRET_ACCESS_KEY}}
R2_BUCKET=${{shared.R2_BUCKET}}
R2_ENDPOINT=${{shared.R2_ENDPOINT}}
R2_PUBLIC_BASE_URL=${{shared.R2_PUBLIC_BASE_URL}}

INFOMANIAK_NEWSLETTER_TOKEN=${{shared.INFOMANIAK_NEWSLETTER_TOKEN}}
INFOMANIAK_NEWSLETTER_CLIENT_API_URL=https://api.infomaniak.com/1/newsletter
INFOMANIAK_NEWSLETTER_DOMAIN_ID=${{shared.INFOMANIAK_NEWSLETTER_DOMAIN_ID}}

# Optional reviewer: set true only after configuring and validating a vision + JSON model.
CLOUDFLARE_AI_ENABLED=false
CLOUDFLARE_ACCOUNT_ID=${{shared.CLOUDFLARE_ACCOUNT_ID}}
CLOUDFLARE_AI_API_TOKEN=${{shared.CLOUDFLARE_AI_API_TOKEN}}
CLOUDFLARE_AI_MODEL=
CLOUDFLARE_AI_FALLBACK_MODEL=
CLOUDFLARE_AI_TIMEOUT=20
CLOUDFLARE_AI_MAX_RETRIES=1
STONE_AI_AUTO_ACCEPT_THRESHOLD=0.85
STONE_AI_REVIEW_THRESHOLD=0.55
CLOUDFLARE_AI_RATE_LIMIT_PER_USER=10
CLOUDFLARE_AI_USER_DAILY_QUOTA=20
CLOUDFLARE_AI_DAILY_QUOTA=500
