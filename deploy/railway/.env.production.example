# Copier vers deploy/railway/.env.production (ignoré par Git) puis remplir.
# Les secrets GemLink internes (APP_SECRET, JWT, INTERNAL_API_KEY, Redis) sont
# générés automatiquement par provision-prod.sh et conservés localement dans
# .generated-secrets.env pour éviter une rotation à chaque exécution.

# Railway / GitHub
RAILWAY_ENVIRONMENT=prod
GITHUB_REPO=
GITHUB_BRANCH=dev

# Domaines GemLink
BACKEND_DOMAIN=caverne.gem-link.org
FRONTEND_URL=https://gem-link.org
CORS_ALLOW_ORIGIN=^https://(www\\.)?gem-link\\.org$

# Mailer : utiliser une NOUVELLE clé, jamais celle exposée auparavant.
MAILER_DSN=
MAILER_FROM_EMAIL=contact@gem-link.org
MAILER_FROM_NAME=GemLink

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=

# Newsletter Infomaniak (optionnel)
INFOMANIAK_NEWSLETTER_TOKEN=
INFOMANIAK_NEWSLETTER_CLIENT_API_URL=https://api.infomaniak.com/1/newsletter
INFOMANIAK_NEWSLETTER_DOMAIN_ID=

# IA
OLLAMA_TEXT_MODEL=qwen3:0.6b
OLLAMA_VISION_MODEL=moondream
DETECTOR_MODEL_VERSION=stone-detector-v1
VIT_MODEL_VERSION=vit-stones-v1
CLIP_MODEL_VERSION=clip-vit-b-32-openai

# Si le Redis actuel doit être remplacé par Redis 7.2 BSD-3-Clause :
# RESET_REDIS=1
RESET_REDIS=0
