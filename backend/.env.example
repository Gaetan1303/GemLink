# Symfony runtime. Railway must override APP_ENV=prod and APP_DEBUG=0.
APP_ENV=dev
APP_DEBUG=1
# Required secret, at least 32 random characters in production.
APP_SECRET=
# Required only when loading development fixtures; never use a shared default.
ADMIN_FIXTURE_PASSWORD=
APP_URL=http://localhost:8000
DEFAULT_URI=http://localhost:8000
FRONTEND_URL=http://localhost:4200

# Reverse proxy validation. Railway should use its private proxy range; keep
# Cloudflare at the frontend only unless the API is explicitly proxied by it.
TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR
TRUSTED_HOSTS=^(localhost|127\.0\.0\.1)(:[0-9]+)?$

# PostgreSQL 16 / pgvector. Keep the serverVersion query parameter at 16.
POSTGRES_VERSION=16
POSTGRES_DB=gemlink
POSTGRES_USER=gemlink
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://gemlink@127.0.0.1:5432/gemlink?serverVersion=16&charset=utf8

# Redis and the three Messenger transports. Use complete DSNs; do not append
# path fragments to a Railway URL at runtime.
REDIS_URL=redis://127.0.0.1:6379
MESSENGER_TRANSPORT_DSN=redis://127.0.0.1:6379/messages
MESSENGER_LOW_PRIORITY_TRANSPORT_DSN=redis://127.0.0.1:6379/identification_low_priority
MESSENGER_FAILED_TRANSPORT_DSN=doctrine://default?queue_name=failed

# Anchored browser-origin regex. Never use .* with credentials enabled.
CORS_ALLOW_ORIGIN=^http://localhost:4200$

# LexikJWTAuthenticationBundle key paths. Generate keys locally; never commit
# the PEM files. JWT_PASSPHRASE is mandatory and secret in production.
JWT_SECRET_KEY=config/jwt/private.pem
JWT_PUBLIC_KEY=config/jwt/public.pem
JWT_PASSPHRASE=

# Mail transport and public sender identity.
MAILER_DSN=null://null
MAILER_FROM_EMAIL=noreply@example.test
MAILER_FROM_NAME="GemLink"

# Private Symfony -> FastAPI connection. INTERNAL_API_KEY must contain at
# least 32 random characters in production and must match FastAPI.
AI_ENABLED=true
AI_SERVICE_URL=http://127.0.0.1:3000
INTERNAL_API_KEY=

# Media storage. Development uses local. Railway production must set r2 and
# provide every R2 variable below.
MEDIA_STORAGE_MODE=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=

# Infomaniak newsletter API. The token is secret; the URL and domain ID are not.
INFOMANIAK_NEWSLETTER_TOKEN=
INFOMANIAK_NEWSLETTER_CLIENT_API_URL=https://api.infomaniak.com/1/newsletter
INFOMANIAK_NEWSLETTER_DOMAIN_ID=
