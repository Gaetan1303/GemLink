APP_ENV=prod
APP_SECRET=f
APP_SHARE_DIR
###< symfony/framework-bundle ###


DEFAULT_URI=http
FRONTEND_URL=https


POSTGRES_VERSION=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_URL=
###< doctrine/doctrine-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:4200)?$'
###< nelmio/cors-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=
###< lexik/jwt-authentication-bundle ###

APP_API_ADMIN_LOGIN=api-admin
APP_API_ADMIN_PASSWORD_HASH=

REDIS_URL=redis://gemlink_redis:6379

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://gemlink_redis:6379/messages

MESSENGER_FAILED_TRANSPORT_DSN=redis://gemlink_redis:6379/messages_failed
MESSENGER_TRANSPORT_DSN=redis://gemlink_redis:6379/messages

MAILER_DSN=brevo+api://xkeysib-@default
MAILER_FROM_EMAIL=contact@gem-link.org
MAILER_FROM_NAME=GemLink

###> infomaniak/newsletter ###
INFOMANIAK_NEWSLETTER_CLIENT_API=
