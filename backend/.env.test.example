# Non-secret defaults for automated tests. Optional local overrides: .env.test.
APP_ENV=test
APP_DEBUG=1
APP_SECRET=test-only-application-secret-not-for-production
APP_URL=http://localhost
ADMIN_ALERT_EMAIL=admin@gem-link.org
EMAIL_VALIDATION_HMAC_SECRET=test-email-validation-secret
PASSWORD_RESET_HMAC_SECRET=test-password-reset-secret
FFPROBE_BINARY=ffprobe
TRUSTED_PROXIES=127.0.0.1
TRUSTED_HOSTS=^(localhost|127\.0\.0\.1)(:[0-9]+)?$
CORS_ALLOW_ORIGIN=^http://localhost:4200$
DATABASE_URL=postgresql://gemlink@127.0.0.1:5433/gemlink?serverVersion=16&charset=utf8
REDIS_URL=redis://127.0.0.1:6379
MESSENGER_TRANSPORT_DSN=${REDIS_URL}/messages
MESSENGER_LOW_PRIORITY_TRANSPORT_DSN=${REDIS_URL}/identification_low_priority
MESSENGER_FAILED_TRANSPORT_DSN=doctrine://default?queue_name=failed
MAILER_DSN=null://null
MAILER_FROM_EMAIL=noreply@example.test
MAILER_FROM_NAME="GemLink Tests"
AI_ENABLED=true
AI_SERVICE_URL=http://ai.invalid
INTERNAL_API_KEY=test-internal-key-with-32-characters
CLOUDFLARE_AI_ENABLED=false
MEDIA_STORAGE_MODE=local
R2_ACCOUNT_ID=test-account
R2_ACCESS_KEY_ID=test-access-key
R2_SECRET_ACCESS_KEY=test-secret-key-not-used-outside-tests
R2_BUCKET=test-bucket
R2_ENDPOINT=https://test.r2.invalid
R2_PUBLIC_BASE_URL=https://media.test.invalid
INFOMANIAK_NEWSLETTER_TOKEN=test-token
INFOMANIAK_NEWSLETTER_CLIENT_API_URL=https://api.infomaniak.com/1/newsletter
INFOMANIAK_NEWSLETTER_DOMAIN_ID=1
