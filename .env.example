# LOCAL DEVELOPMENT ONLY. Never reuse these values in Railway or Cloudflare.
POSTGRES_DB=gemlink
POSTGRES_USER=gemlink
POSTGRES_PASSWORD=gemlink-local-development
APP_SECRET=gemlink-local-app-secret-at-least-32-characters
ADMIN_FIXTURE_PASSWORD=
INTERNAL_API_KEY=gemlink-local-internal-key-at-least-32-characters
JWT_PASSPHRASE=

# Optional server-side reviewer (Compose API + Messenger worker only).
CLOUDFLARE_AI_ENABLED=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
CLOUDFLARE_AI_MODEL=
CLOUDFLARE_AI_FALLBACK_MODEL=
